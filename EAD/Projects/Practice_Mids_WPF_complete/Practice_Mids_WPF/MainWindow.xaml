    <Grid>
        <DataGrid Name="myGrid" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,241,0,0" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="*"/>
                <DataGridTemplateColumn Header="Delete" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Delete" Click="Delete"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Edit" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Edit" Click="MakeEditable"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBox Name="t1" HorizontalAlignment="Left" Margin="142,58,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="120" Height="16" Grid.Row="1"/>
        <TextBox Name="t2" HorizontalAlignment="Left" Margin="142,134,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="120" Height="17" Grid.Row="1"/>
        <Label Content="Enter name" HorizontalAlignment="Left" Margin="46,54,0,0" VerticalAlignment="Top" Height="32" Grid.Row="1"/>
        <Label Content="Enter Age" HorizontalAlignment="Left" Margin="46,126,0,0" VerticalAlignment="Top" Height="25" Grid.Row="1"/>
        <Button Name="b1" Content="Add Product" HorizontalAlignment="Left" Margin="359,108,0,0" VerticalAlignment="Top" Click="Add" Height="22" Grid.Row="1"/>
        <Button Name="b2" Visibility="Hidden" Content="Edit" HorizontalAlignment="Left" Margin="475,108,0,0" VerticalAlignment="Top" Click="EditPerson" Height="22" Grid.Row="1"/>
    </Grid>
</Window>
 