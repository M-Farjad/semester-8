<Window x:Class="Practice_Mids_WPF.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Practice_Mids_WPF"
        mc:Ignorable="d"
    Title="Edit Person" Height="200" Width="300">
    <Grid>
        <Label Content="Name:" HorizontalAlignment="Left" Margin="10,10,0,0"/>
        <TextBox Name="NameTextBox" HorizontalAlignment="Left" Margin="60,10,0,147" Width="185" Height="40"/>

        <Label Content="Age:" HorizontalAlignment="Left" Margin="10,50,0,0"/>
        <TextBox Name="AgeTextBox" HorizontalAlignment="Left" Margin="68,50,0,107" Width="170" Height="40"/>

        <Button Content="Save" Width="80" Height="30" Margin="110,100,0,0" Click="Click_On_Save_Button"/>
    </Grid>
</Window>
