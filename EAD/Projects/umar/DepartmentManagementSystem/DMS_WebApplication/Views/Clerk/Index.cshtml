@model List<Student>
@{
    ViewBag.Title = "Clerk Panel";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Student Management</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        :root {
            --dms-primary: #E07A5F;
            --dms-primary-dark: #C56A52;
            --dms-primary-light: #F7C1B3;
            --dms-surface: #FFFFFF;
            --dms-surface-light: #F9F5F3;
            --dms-background: #F5F1EE;
            --dms-text: #333333;
            --dms-text-light: #7A6F6B;
            --dms-border: #E0D7D2;
            --dms-error: #D16666;
            --dms-success: #7A9F6B;
            --dms-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
            --dms-card-radius: 12px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
        }

        body {
            background: var(--dms-background);
            color: var(--dms-text);
            line-height: 1.6;
        }

        .dms-admin-container {
            display: grid;
            grid-template-columns: 280px 1fr;
            min-height: 100vh;
        }

        /* Sidebar */
        .dms-sidebar {
            background: var(--dms-surface);
            border-right: 1px solid var(--dms-border);
            padding: 24px 0;
        }

        .dms-brand {
            display: flex;
            align-items: center;
            padding: 0 24px 24px;
            border-bottom: 1px solid var(--dms-border);
            margin-bottom: 24px;
        }

        .dms-brand-icon {
            width: 40px;
            height: 40px;
            background: var(--dms-primary);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            margin-right: 12px;
        }

        .dms-brand-text {
            font-weight: 700;
            font-size: 18px;
        }

        .dms-nav-item {
            display: flex;
            align-items: center;
            padding: 12px 24px;
            color: var(--dms-text-light);
            text-decoration: none;
            transition: all 0.2s;
        }

            .dms-nav-item i {
                margin-right: 12px;
                font-size: 20px;
                width: 24px;
                text-align: center;
            }

            .dms-nav-item:hover, .dms-nav-item.active {
                color: var(--dms-primary);
                background: rgba(224, 122, 95, 0.08);
                border-right: 3px solid var(--dms-primary);
            }

        /* Main Content */
        .dms-main-content {
            padding: 32px;
            background: var(--dms-background);
        }

        .dms-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 32px;
        }

        .dms-page-title {
            font-size: 24px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .dms-page-title i {
                color: var(--dms-primary);
            }

        /* Cards */
        .dms-card {
            background: var(--dms-surface);
            border-radius: var(--dms-card-radius);
            box-shadow: var(--dms-shadow);
            padding: 0;
            margin-bottom: 24px;
            overflow: hidden;
        }

        .dms-card-header {
            padding: 20px 24px;
            border-bottom: 1px solid var(--dms-border);
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .dms-card-header i {
                color: var(--dms-primary);
            }

        .dms-card-body {
            padding: 24px;
        }

        /* Forms */
        .dms-form-row {
            display: flex;
            gap: 16px;
            margin-bottom: 16px;
        }

        .dms-form-group {
            flex: 1;
            position: relative;
        }

        .dms-form-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--dms-primary);
        }

        .dms-form-input {
            width: 100%;
            padding: 12px 16px 12px 44px;
            border: 1px solid var(--dms-border);
            border-radius: 8px;
            background: var(--dms-surface-light);
            font-size: 14px;
            transition: all 0.2s;
        }

            .dms-form-input:focus {
                border-color: var(--dms-primary);
                outline: none;
                box-shadow: 0 0 0 3px rgba(224, 122, 95, 0.1);
            }

        .dms-form-select {
            appearance: none;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23E07A5F' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right 12px center;
            background-size: 16px;
        }

        /* Buttons */
        .dms-btn {
            padding: 10px 16px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: none;
        }

        .dms-btn-primary {
            background: var(--dms-primary);
            color: white;
        }

            .dms-btn-primary:hover {
                background: var(--dms-primary-dark);
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            }

        .dms-btn-outline {
            background: transparent;
            border: 1px solid var(--dms-primary);
            color: var(--dms-primary);
        }

            .dms-btn-outline:hover {
                background: rgba(224, 122, 95, 0.1);
            }

        .dms-btn-danger {
            background: var(--dms-error);
            color: white;
        }

            .dms-btn-danger:hover {
                background: #C25B5B;
            }

        .dms-btn-sm {
            padding: 8px 12px;
            font-size: 13px;
        }

        /* Table */
        .dms-table {
            width: 100%;
            border-collapse: collapse;
        }

            .dms-table th {
                text-align: left;
                padding: 16px 24px;
                background: var(--dms-surface-light);
                color: var(--dms-text-light);
                font-weight: 500;
                border-bottom: 1px solid var(--dms-border);
            }

            .dms-table td {
                padding: 16px 24px;
                border-bottom: 1px solid var(--dms-border);
                vertical-align: middle;
            }

            .dms-table tr:last-child td {
                border-bottom: none;
            }

            .dms-table tr:hover td {
                background: rgba(224, 122, 95, 0.03);
            }

        .dms-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--dms-surface-light);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--dms-primary);
            margin-right: 12px;
            border: 1px solid var(--dms-border);
        }

        .dms-badge {
            display: inline-block;
            padding: 6px 12px;
            background: var(--dms-surface-light);
            border: 1px solid var(--dms-border);
            border-radius: 20px;
            font-size: 13px;
        }

        .dms-empty-state {
            padding: 48px 24px;
            text-align: center;
        }

            .dms-empty-state i {
                font-size: 56px;
                color: var(--dms-border);
                opacity: 0.5;
                margin-bottom: 16px;
            }

            .dms-empty-state p {
                color: var(--dms-text-light);
                max-width: 400px;
                margin: 0 auto 24px;
            }

        /* Alerts */
        .dms-alert {
            padding: 16px;
            border-radius: 8px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .dms-alert-success {
            background: rgba(122, 159, 107, 0.1);
            border-left: 4px solid var(--dms-success);
            color: var(--dms-success);
        }

        .dms-alert-error {
            background: rgba(209, 102, 102, 0.1);
            border-left: 4px solid var(--dms-error);
            color: var(--dms-error);
        }
    </style>
</head>
<body>
    <div class="dms-admin-container">
        <!-- Sidebar -->
        <div class="dms-sidebar">
            <div class="dms-brand">
                <div class="dms-brand-icon">
                    <i class="fas fa-user-tie"></i>
                </div>
                <div class="dms-brand-text">Clerk Panel</div>
            </div>
            <nav>
                <a href="#" class="dms-nav-item active">
                    <i class="fas fa-graduation-cap"></i>
                    Students
                </a>
                <a href="/Clerk/GenerateSittingPlan" class="dms-nav-item">
                    <i class="fas fa-grid"></i>
                    Sitting Plan
                </a>
                <a href="/Clerk/GenerateAttendanceSheet" class="dms-nav-item">
                    <i class="fas fa-clipboard-list"></i>
                    Attendance Sheet
                </a>
            </nav>
        </div>

        <!-- Main Content -->
        <div class="dms-main-content">
            <div class="dms-header">
                <h1 class="dms-page-title">
                    <i class="fas fa-graduation-cap"></i>
                    Student Management
                </h1>
                <a href="/Account/Logout" class="dms-btn dms-btn-outline">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            </div>

            <!-- Stats Card -->
            <div class="dms-card">
                <div class="dms-card-header">
                    <i class="fas fa-chart-pie"></i>
                    <h3>Statistics</h3>
                </div>
                <div class="dms-card-body">
                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;">
                        <div style="background: var(--dms-surface-light); padding: 16px; border-radius: 8px;">
                            <div style="font-size: 13px; color: var(--dms-text-light); margin-bottom: 8px;">
                                <i class="fas fa-users"></i> Total Students
                            </div>
                            <div style="font-size: 24px; font-weight: 600;">@Model.Count</div>
                        </div>
                        <div style="background: var(--dms-surface-light); padding: 16px; border-radius: 8px;">
                            <div style="font-size: 13px; color: var(--dms-text-light); margin-bottom: 8px;">
                                <i class="fas fa-layer-group"></i> Sections
                            </div>
                            <div style="font-size: 24px; font-weight: 600;">@Model.Select(s => s.Section.Name).Distinct().Count()</div>
                        </div>
                        <div style="background: var(--dms-surface-light); padding: 16px; border-radius: 8px;">
                            <div style="font-size: 13px; color: var(--dms-text-light); margin-bottom: 8px;">
                                <i class="fas fa-calendar-alt"></i> Sessions
                            </div>
                            <div style="font-size: 24px; font-weight: 600;">@Model.Select(s => s.Session.Name).Distinct().Count()</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Student List Card -->
            <div class="dms-card">
                <div class="dms-card-header">
                    <i class="fas fa-users"></i>
                    <h3>Student List</h3>
                    <span class="dms-badge">@Model.Count</span>
                </div>
                <div class="dms-card-body">
                    @if (Model.Any())
                    {
                        <table class="dms-table">
                            <thead>
                                <tr>
                                    <th>Student</th>
                                    <th>Registration</th>
                                    <th>Section</th>
                                    <th>Session</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model)
                                {
                                    <tr>
                                        <td>
                                            <div style="display: flex; align-items: center;">
                                                <div class="dms-avatar">
                                                    <i class="fas fa-user"></i>
                                                </div>
                                                <div>@s.Name</div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="dms-badge">@s.RegNo</span>
                                        </td>
                                        <td>@s.Section.Name</td>
                                        <td>@s.Session.Name</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="dms-empty-state">
                            <i class="fas fa-users-slash"></i>
                            <p>No students found in the system</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <script>
        // Table row hover effects
        document.querySelectorAll('.dms-table tbody tr').forEach(row => {
            row.addEventListener('mouseenter', function() {
                this.style.transform = 'translateX(4px)';
                this.style.transition = 'transform 0.2s ease';
            });
            row.addEventListener('mouseleave', function() {
                this.style.transform = 'translateX(0)';
            });
        });
    </script>
</body>
</html>