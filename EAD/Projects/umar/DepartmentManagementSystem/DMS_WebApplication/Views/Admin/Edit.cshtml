@model Student
@{
    ViewBag.Title = "Edit Student - Admin Portal";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        :root {
            --dms-primary: #E07A5F;
            --dms-primary-dark: #C56A52;
            --dms-primary-light: #F7C1B3;
            --dms-surface: #FFFFFF;
            --dms-surface-light: #F9F5F3;
            --dms-background: #F5F1EE;
            --dms-text: #333333;
            --dms-text-light: #7A6F6B;
            --dms-border: #E0D7D2;
            --dms-error: #D16666;
            --dms-success: #7A9F6B;
            --dms-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
            --dms-card-radius: 12px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
        }

        body {
            background: var(--dms-background);
            color: var(--dms-text);
            line-height: 1.6;
        }

        .dms-container {
            max-width: 800px;
            margin: 40px auto;
            padding: 0 20px;
        }

        /* Header */
        .dms-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 32px;
        }

        .dms-page-title {
            font-size: 24px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .dms-page-title i {
                color: var(--dms-primary);
            }

        /* Cards */
        .dms-card {
            background: var(--dms-surface);
            border-radius: var(--dms-card-radius);
            box-shadow: var(--dms-shadow);
            padding: 0;
            margin-bottom: 24px;
            overflow: hidden;
        }

        .dms-card-header {
            padding: 20px 24px;
            border-bottom: 1px solid var(--dms-border);
            display: flex;
            align-items: center;
            gap: 12px;
        }

            .dms-card-header i {
                color: var(--dms-primary);
            }

        .dms-card-body {
            padding: 24px;
        }

        /* Student Info */
        .dms-student-info {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 24px;
            padding: 16px;
            background: var(--dms-surface-light);
            border-radius: 8px;
        }

        .dms-avatar {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: var(--dms-surface-light);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--dms-primary);
            font-size: 24px;
            border: 1px solid var(--dms-border);
        }

        .dms-student-details h4 {
            margin: 0 0 4px 0;
            font-weight: 600;
        }

        .dms-badge {
            display: inline-block;
            padding: 6px 12px;
            background: var(--dms-surface-light);
            border: 1px solid var(--dms-border);
            border-radius: 20px;
            font-size: 13px;
        }

        /* Forms */
        .dms-form-group {
            margin-bottom: 20px;
        }

        .dms-form-label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
            color: var(--dms-text);
        }

        .dms-input-group {
            position: relative;
        }

        .dms-form-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--dms-primary);
        }

        .dms-form-input {
            width: 100%;
            padding: 12px 16px 12px 44px;
            border: 1px solid var(--dms-border);
            border-radius: 8px;
            background: var(--dms-surface-light);
            font-size: 14px;
            transition: all 0.2s;
        }

            .dms-form-input:focus {
                border-color: var(--dms-primary);
                outline: none;
                box-shadow: 0 0 0 3px rgba(224, 122, 95, 0.1);
            }

        .dms-form-select {
            appearance: none;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23E07A5F' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right 12px center;
            background-size: 16px;
        }

        /* Buttons */
        .dms-btn {
            padding: 10px 16px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: none;
        }

        .dms-btn-primary {
            background: var(--dms-primary);
            color: white;
        }

            .dms-btn-primary:hover {
                background: var(--dms-primary-dark);
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            }

        .dms-btn-outline {
            background: transparent;
            border: 1px solid var(--dms-primary);
            color: var(--dms-primary);
        }

            .dms-btn-outline:hover {
                background: rgba(224, 122, 95, 0.1);
            }

        .dms-btn-group {
            display: flex;
            gap: 12px;
            justify-content: flex-end;
            margin-top: 32px;
        }

        /* Alerts */
        .dms-alert {
            padding: 16px;
            border-radius: 8px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .dms-alert-error {
            background: rgba(209, 102, 102, 0.1);
            border-left: 4px solid var(--dms-error);
            color: var(--dms-error);
        }

        /* Back Link */
        .dms-back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--dms-primary);
            text-decoration: none;
            margin-top: 24px;
            transition: all 0.2s;
        }

            .dms-back-link:hover {
                color: var(--dms-primary-dark);
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .dms-container {
                padding: 0 16px;
            }

            .dms-card-body {
                padding: 20px;
            }

            .dms-btn-group {
                flex-direction: column;
            }

            .dms-btn {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="dms-container">
        <!-- Notification Area -->
        @if (TempData["Error"] != null)
        {
            <div class="dms-alert dms-alert-error">
                <i class="fas fa-exclamation-circle"></i>
                <div>@TempData["Error"]</div>
            </div>
        }

        <div class="dms-header">
            <h1 class="dms-page-title">
                <i class="fas fa-user-edit"></i>
                Edit Student
            </h1>
            <a href="/Account/Logout" class="dms-btn dms-btn-outline">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </div>

        <div class="dms-card">
            <div class="dms-card-header">
                <i class="fas fa-user-graduate"></i>
                <h3>Student Information</h3>
            </div>
            <div class="dms-card-body">
                <!-- Student Info -->
                <div class="dms-student-info">
                    <div class="dms-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                    <div class="dms-student-details">
                        <h4>@Model.Name</h4>
                        <span class="dms-badge">@Model.RegNo</span>
                    </div>
                </div>

                <form method="post" asp-action="Edit">
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="dms-form-group">
                        <label class="dms-form-label">Student Name</label>
                        <div class="dms-input-group">
                            <i class="fas fa-user dms-form-icon"></i>
                            <input name="name" class="dms-form-input" value="@Model.Name"
                                   placeholder="Full Name" required />
                        </div>
                    </div>

                    <div class="dms-form-group">
                        <label class="dms-form-label">Registration Number</label>
                        <div class="dms-input-group">
                            <i class="fas fa-id-card dms-form-icon"></i>
                            <input name="regNo" class="dms-form-input" value="@Model.RegNo"
                                   placeholder="Registration Number" required />
                        </div>
                    </div>

                    <div class="dms-form-group">
                        <label class="dms-form-label">Section</label>
                        <div class="dms-input-group">
                            <i class="fas fa-layer-group dms-form-icon"></i>
                            <select name="sectionId" class="dms-form-input dms-form-select" required>
                                <option value="">Select Section</option>
                                @foreach (var sect in ViewBag.Sections as List<Section>)
                                {
                                    @if (Model.SectionId == sect.Id)
                                    {
                                        <option value="@sect.Id" selected>@sect.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@sect.Id">@sect.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="dms-form-group">
                        <label class="dms-form-label">Session</label>
                        <div class="dms-input-group">
                            <i class="fas fa-calendar-alt dms-form-icon"></i>
                            <select name="sessionId" class="dms-form-input dms-form-select" required>
                                <option value="">Select Session</option>
                                @foreach (var session in ViewBag.Sessions as List<Session>)
                                {
                                    @if (Model.SessionId == session.Id)
                                    {
                                        <option value="@session.Id" selected>@session.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@session.Id">@session.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="dms-btn-group">
                        <a href="@Url.Action("Index", "Admin")" class="dms-btn dms-btn-outline">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                        <button type="submit" class="dms-btn dms-btn-primary">
                            <i class="fas fa-save"></i> Save Changes
                        </button>
                    </div>
                </form>

                <div style="text-align: center;">
                    <a href="@Url.Action("Index", "Admin")" class="dms-back-link">
                        <i class="fas fa-arrow-left"></i> Back to Student Management
                    </a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>