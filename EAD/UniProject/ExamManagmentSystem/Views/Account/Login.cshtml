@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    ViewData["Title"] = "Login";
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<h2 class="text-center">Login</h2>

<form asp-controller="Account" asp-action="Login" method="post" class="form-horizontal" style="max-width:400px; margin:auto;">
    <div class="form-group">
        <label>Email</label>
        <input type="email" name="email" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" class="form-control" required />
    </div>
    <div class="form-group mt-3">
        <button type="submit" class="btn btn-primary w-100">Login</button>
    </div>
</form>

<div class="text-center mt-3">
    <a href="@Url.Action("ForgotPassword", "Account")">Forgot Password?</a><br />
    <a href="@Url.Action("ChangePassword", "Account")">Change Password</a>
</div>
