@{
    ViewBag.Title = "Create Batch and Section";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var batches = ViewBag.Batches as List<ExamManagmentSystem.Models.Batch>;
}

<h2>Create Batch and Section</h2>

<form asp-controller="BatchSection" asp-action="Create" method="post">
    <div class="form-group">
        <label for="existingBatchId">Select Existing Batch (Optional)</label>
        <select class="form-control" id="existingBatchId" name="existingBatchId">
            <option value="">-- Select Existing Batch --</option>
            @if (batches != null)
            {
                foreach (var batch in batches)
                {
                    <option value="@batch.Id">@batch.Year</option>
                }
            }
        </select>
    </div>

    <div class="form-group">
        <label for="batchYear">Or Add New Batch Year</label>
        <input type="text" class="form-control" id="batchYear" name="batchYear" placeholder="e.g. 2025" />
        <small class="form-text text-muted">Leave this blank if you're selecting an existing batch above.</small>
    </div>

    <div class="form-group">
        <label for="sectionName">Section Name</label>
        <input type="text" class="form-control" id="sectionName" name="sectionName" placeholder="e.g. CS(A)" required />
    </div>

    <button type="submit" class="btn btn-success">Create</button>
</form>
