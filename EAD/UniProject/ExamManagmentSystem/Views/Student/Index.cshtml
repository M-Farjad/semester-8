@model List<ExamManagmentSystem.Models.Student>

@{
    ViewBag.Title = "Students";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var batches = ViewBag.Batches as List<ExamManagmentSystem.Models.Batch>;
    var selectedBatchId = ViewBag.BatchId as int?;
    var selectedSectionId = ViewBag.SectionId as int?;
    var rollFilter = ViewBag.Roll as string ?? "";
}

<h2>Search Students</h2>

<form method="get">
    <div class="form-row">
        <div class="col">
            <select name="batchId" class="form-control">
                <option value="">Select Batch</option>
                @if (batches != null)
                {
                    foreach (var batch in batches)
                    {
                        @Html.Raw($"<option value=\"{batch.Id}\" {(selectedBatchId == batch.Id ? "selected" : "")}>{(batch.Year)}</option>")
                    }
                }
            </select>
        </div>
        <div class="col">
            <select name="sectionId" class="form-control">
                <option value="">Select Section</option>
                @if (batches != null && selectedBatchId.HasValue)
                {
                    var batch = batches.FirstOrDefault(b => b.Id == selectedBatchId.Value);
                    if (batch != null && batch.Sections != null)
                    {
                        foreach (var section in batch.Sections)
                        {
                            @Html.Raw($"<option value=\"{section.Id}\" {(selectedSectionId == section.Id ? "selected" : "")}>{(section.Name)}</option>")
                        }
                    }
                }
            </select>
        </div>
        <div class="col">
            <input type="text" name="roll" value="@rollFilter" placeholder="Roll Number" class="form-control" />
        </div>
        <div class="col">
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
    </div>
</form>

<a href="/Student/Create" class="btn btn-success mt-3">Add New Student</a>

<table class="table table-bordered mt-3">
    <thead>
        <tr>
            <th>Name</th>
            <th>Age</th>
            <th>Gender</th>
            <th>CNIC</th>
            <th>Address</th>
            <th>Roll #</th>
            <th>Batch</th>
            <th>Section</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Name</td>
                <td>@s.Age</td>
                <td>@s.Gender</td>
                <td>@s.CNIC</td>
                <td>@s.Address</td>
                <td>@s.RollNumber</td>
                <td>@s.Section?.Batch?.Year</td>
                <td>@s.Section?.Name</td>
                <td>@s.Email</td>
                <td>@s.Phone</td>
                <td>
                    <a href="/Student/Edit/@s.Id">Edit</a> |
                    <a href="/Student/Details/@s.Id">Details</a> |
                    <a href="/Student/Delete/@s.Id" onclick="return confirm('Are you sure you want to delete this student?');">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
