@{
    ViewBag.Title = "Exam Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var batches = ViewBag.Batches as List<string>;
}

<h2>Exam Management</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<form id="examForm" method="post">
    <div class="form-group">
        <label>Batch</label>
        <select id="batchSelect" name="batch" class="form-control" required>
            <option value="">Select Batch</option>
            @foreach (var batch in batches)
            {
                <option value="@batch">@batch</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label>Section</label>
        <select id="sectionSelect" name="section" class="form-control" required>
            <option value="">Select Section</option>
        </select>
    </div>

    <div class="form-group mt-3">
        <button type="submit" formaction="/Exam/GenerateAttendanceSheet" class="btn btn-primary">Generate Attendance Sheet</button>
        <button type="submit" formaction="/Exam/GenerateSittingPlan" class="btn btn-warning">Generate Sitting Plan</button>
    </div>
</form>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $('#batchSelect').change(function () {
            var selectedBatch = $(this).val();
            $('#sectionSelect').empty().append('<option value="">Loading...</option>');

            if (selectedBatch) {
                $.getJSON('/Exam/GetSections', { batch: selectedBatch }, function (sections) {
                    $('#sectionSelect').empty().append('<option value="">Select Section</option>');
                    $.each(sections, function (index, section) {
                        $('#sectionSelect').append('<option value="' + section + '">' + section + '</option>');
                    });
                });
            } else {
                $('#sectionSelect').empty().append('<option value="">Select Section</option>');
            }
        });
    </script>
}
