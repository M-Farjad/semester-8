@using Microsoft.AspNetCore.Identity
@model List<IdentityRole>

@{
    ViewBag.Title = "Manage Roles";
}

<div class="container mt-4">
    <h2 class="mb-4">Manage Roles</h2>

    <div class="mb-3">
        <a class="btn btn-primary" asp-action="CreateRole">
            <i class="fas fa-plus"></i> Create New Role
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <table class="table table-bordered table-hover">
            <thead class="thead-dark">
                <tr>
                    <th>Role Name</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model)
                {
                    <tr>
                        <td>@role.Name</td>
                        <td>
                            <a asp-action="EditRole" asp-route-id="@role.Id" class="btn btn-sm btn-warning mr-2">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            <a asp-action="DeleteRole" asp-route-id="@role.Id"
                               class="btn btn-sm btn-danger"
                               onclick="return confirm('Are you sure you want to delete this role?');">
                                <i class="fas fa-trash"></i> Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">No roles found.</div>
    }
</div>
